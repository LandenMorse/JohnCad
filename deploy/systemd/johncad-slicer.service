# Installed by scripts/setup-pi.sh, which replaces @USER@ and @DIR@.
[Unit]
Description=JohnCad slicing worker
After=network.target docker.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=@DIR@/.env
ExecStart=@DIR@/.venv/bin/python manage.py slice_worker
Restart=always

[Install]
WantedBy=multi-user.target
