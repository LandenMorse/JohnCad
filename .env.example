SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, e.g. https://yourdomain.com — needed once served through
# nginx on a real domain (see nginx/nginx.conf).
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=johncad
POSTGRES_USER=johncad
POSTGRES_PASSWORD=johncad
# localhost is correct for host-venv dev (against the standalone db
# container). "docker compose up" overrides this to "db" automatically for
# the containerized web service, no edit needed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PrusaSlicer CLI (attachments/slicing.py). PRUSA_SLICER_BIN defaults to
# "prusa-slicer" on PATH; only set it if the binary lives elsewhere.
PRUSA_SLICER_BIN=prusa-slicer
# Path to an exported PrusaSlicer config bundle (.ini). Leave blank to slice
# with bare CLI defaults.
PRUSA_SLICER_PROFILE=
PRUSA_SLICER_TIMEOUT=300
