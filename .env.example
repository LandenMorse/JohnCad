SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, e.g. https://rhsprint.crabdance.com — needed once served through
# nginx on a real domain (see nginx/nginx.conf).
CSRF_TRUSTED_ORIGINS=
# Set True once served over HTTPS (marks session/CSRF cookies Secure).
HTTPS_ENABLED=False

# Local dev only: set to "sqlite" to use a throwaway db.sqlite3 instead of
# Postgres (no Postgres instance needed). Leave unset/blank in every real
# deployment -- defaults to postgresql.
DATABASE_ENGINE=

POSTGRES_DB=johncad
POSTGRES_USER=johncad
POSTGRES_PASSWORD=johncad
# localhost is correct for host-venv dev (against the standalone db
# container). "docker compose up" overrides this to "db" automatically for
# the containerized web service, no edit needed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OrcaSlicer CLI (jobs/slicing.py). Launched via Flatpak on the Pi.
ORCA_SLICER_CMD=flatpak run com.orcaslicer.OrcaSlicer
# Semicolon-separated machine + process preset .json files (required for
# slicing; blank = slicer treated as not configured).
ORCA_SLICER_SETTINGS=
# Semicolon-separated filament preset .json file(s) (optional).
ORCA_SLICER_FILAMENTS=
# Optional OrcaSlicer --datadir.
ORCA_SLICER_DATADIR=
ORCA_SLICER_TIMEOUT=300

# Bambuddy (jobs/bambuddy.py). Self-hosted on the Pi, see docs/BAMBUDDY_PLAN.md.
# Base URL, e.g. http://127.0.0.1:8080. Blank = dispatch not configured.
BAMBUDDY_URL=
# API key from Bambuddy (Settings > API keys): Manage Queue, Manage Library,
# Read Status, Control Printer.
BAMBUDDY_API_KEY=
# Shared secret for Bambuddy's webhook. Point the webhook at
# http://127.0.0.1:8000/api/bambuddy/webhook/?secret=<this value>
# (or send it as an X-Webhook-Secret header). Blank rejects all webhooks.
BAMBUDDY_WEBHOOK_SECRET=
# Bambuddy's id for the printer jobs are sent to.
BAMBUDDY_PRINTER_ID=
# True = jobs wait in Bambuddy until staff click "Plate cleared, release next".
BAMBUDDY_STAGED=True
BAMBUDDY_TIMEOUT=60
# docker-compose bambuddy service: image tag (pin a release) and port.
BAMBUDDY_VERSION=latest
BAMBUDDY_PORT=8080
