SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, e.g. https://print.example.org — needed once served through
# Caddy on a real domain (see deploy/caddy/Caddyfile.example).
CSRF_TRUSTED_ORIGINS=
# Set True once served over HTTPS through Caddy (marks session/CSRF cookies Secure).
HTTPS_ENABLED=False

# Local dev only: set to "sqlite" to use a throwaway db.sqlite3 instead of
# Postgres (no Postgres instance needed). Leave unset/blank in every real
# deployment -- defaults to postgresql.
DATABASE_ENGINE=

POSTGRES_DB=johncad
POSTGRES_USER=johncad
POSTGRES_PASSWORD=johncad
# localhost is right: Postgres runs in Docker (docker compose up -d db) and
# publishes its port on 127.0.0.1 only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OrcaSlicer CLI (jobs/slicing.py). Launched via Flatpak on the Pi.
ORCA_SLICER_CMD=flatpak run com.orcaslicer.OrcaSlicer
# Semicolon-separated machine + process preset .json files (required for
# slicing; blank = slicer treated as not configured).
ORCA_SLICER_SETTINGS=
# Semicolon-separated filament preset .json file(s) (optional).
ORCA_SLICER_FILAMENTS=
# Optional OrcaSlicer --datadir.
ORCA_SLICER_DATADIR=
ORCA_SLICER_TIMEOUT=300

# Direct mode only (BAMBUDDY_VIA_AGENT=False, see docs/bambuddy.md): Bambuddy
# runs on this same host. With a print agent (below) none of these Bambuddy
# values, except BAMBUDDY_STAGED, are used on the site; they go in the agent's
# /etc/johncad-agent.env instead. Base URL; defaults to http://127.0.0.1:8080.
BAMBUDDY_URL=http://127.0.0.1:8080
# API key from Bambuddy (Settings > API keys) with "Manage library",
# "Add to queue" and "Read status". Blank = dispatch not configured.
BAMBUDDY_API_KEY=
# Shared secret for Bambuddy's webhook. In Bambuddy add a Webhook notification
# provider (payload format "generic") with URL
# http://127.0.0.1:8000/api/bambuddy/webhook/ and this value as its
# "Auth header". Blank rejects all webhooks.
BAMBUDDY_WEBHOOK_SECRET=
# Fallback Bambuddy printer id for jobs with no printer chosen. With several
# printers, add them as Printers in /admin/ instead; teachers pick one per job.
BAMBUDDY_PRINTER_ID=
# True = jobs wait in Bambuddy until staff click "Plate cleared, release next".
BAMBUDDY_STAGED=True
BAMBUDDY_TIMEOUT=60
# Print agent (agent/README.md): True when Bambuddy is NOT on this host and an
# agent next to it (the school Pi) pulls jobs from /agent-api/ over HTTPS. The
# dispatch worker isn't used then. Agent keys: /admin/ > Printer agents.
# scripts/setup-site.sh sets this to True.
BAMBUDDY_VIA_AGENT=True
AGENT_CLAIM_TIMEOUT=900
AGENT_POLL_INTERVAL=15
# docker-compose bambuddy service, which runs on the SCHOOL Pi (not the site Pi):
# image tag (pin a release) and port.
BAMBUDDY_VERSION=latest
BAMBUDDY_PORT=8080

# Backups (scripts/backup.sh, run nightly by the johncad-backup timer).
# Where backups are written; blank = <project>/backups. Point it at a USB
# drive or network share so a failed SD card doesn't take the backups too.
BACKUP_DIR=
# How many backups to keep; blank = 14.
BACKUP_KEEP=
