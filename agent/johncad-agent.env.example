# /etc/johncad-agent.env on the school Pi (sudo chmod 600 it: it holds keys).

# The JohnCad site and this agent's key, from /admin/ > Printer agents, or
# `python manage.py create_agent_key school-pi` on the server.
JOHNCAD_URL=https://print.example.org
JOHNCAD_AGENT_KEY=

# Bambuddy on this Pi. API key from Bambuddy (Settings > API keys) with
# "Manage library", "Add to queue", "Read status", and permission to add and
# remove printers (for printers teachers add on the site's Printers page).
BAMBUDDY_URL=http://127.0.0.1:8080
BAMBUDDY_API_KEY=
# Bambuddy printer id for jobs with no printer chosen (optional once every
# job gets a printer on /review/).
BAMBUDDY_PRINTER_ID=

# Where downloads and pending reports are kept (systemd's StateDirectory).
AGENT_STATE_DIR=/var/lib/johncad-agent
# Download chunk size in MB. Smaller = less to redo after a dropped connection.
AGENT_CHUNK_MB=4
# Seconds between check-ins; blank = what the site says (AGENT_POLL_INTERVAL there).
AGENT_POLL_INTERVAL=
# Seconds to wait for Bambuddy to connect to a printer a teacher asked to add
# before reporting that it failed.
AGENT_PRINTER_CONNECT_TIMEOUT=60
